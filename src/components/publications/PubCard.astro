---
import type { ProcessedPublication } from "@/types"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"
import Link from "@/components/base/Link.astro"

interface Props {
  pub: ProcessedPublication
}

const { pub } = Astro.props
const imageSources = import.meta.glob<ImageMetadata>("/images/*.png", {
  eager: true,
  import: "default",
})
const optimizedImage =
  pub.image && imageSources[pub.image]
    ? await getImage({
        src: imageSources[pub.image],
        width: 640,
        format: "webp",
      })
    : undefined
const imageSrc = optimizedImage?.src ?? pub.image
const authors = pub.authorData.hasMore
  ? `${pub.authorData.displayFirstAuthors} ${pub.authorData.hiddenAuthors}${pub.authorData.displayLastAuthors ? `, ${pub.authorData.displayLastAuthors}` : ""}`
  : pub.authorData.displayFirstAuthors
const linkLabels: Record<string, string> = { Website: "Project", PDF: "Paper" }
const linkOrder = ["Website", "PDF", "Code"]
const links = [...pub.links].sort((a, b) => {
  const rank = (label: string) => {
    const index = linkOrder.indexOf(label)
    return index === -1 ? linkOrder.length : index
  }
  return rank(a.label) - rank(b.label)
})
---

<article
  class="publication-card"
  data-has-image={pub.image ? "true" : undefined}
>
  {pub.image && (
    <div class="publication-media">
      {pub.previewVideo ? (
        <video controls muted loop playsinline preload="none" poster={imageSrc} aria-label={`Research demonstration for ${pub.title}`}>
          <source src={pub.previewVideo} type="video/mp4" />
          <a href={pub.previewVideo}>Watch the research demonstration</a>
        </video>
      ) : (
        <img src={imageSrc} alt={pub.imageAlt ?? `Visual summary for “${pub.title}”`} width="1200" height="720" loading="lazy" decoding="async" />
      )}
    </div>
  )}
  <div class="publication-body">
    <h3 class="publication-title">
      {pub.mainUrl ? <Link href={pub.mainUrl} external underline>{pub.title}</Link> : pub.title}
    </h3>
    <p class="bibliography-authors" set:html={authors} />
    {(pub.publisher || pub.year) && (
      <p class="bibliography-details">
        {pub.publisher}{pub.publisher && pub.year && " · "}{pub.year}
        {pub.award && <span class="publication-award"> · {pub.award}</span>}
      </p>
    )}
    {pub.abstract && <p class="publication-abstract">{pub.abstract}</p>}
    <ul class="publication-links" aria-label={`Links for ${pub.title}`}>
      {links.map(({ href, label }) => (
        <li><Link href={href} external underline>{linkLabels[label] ?? label}</Link></li>
      ))}
    </ul>
  </div>
</article>

<style>
  .publication-card {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-s);
    min-inline-size: 0;
  }

  .publication-card + .publication-card {
    border-block-start: 1px solid var(--border);
  }

  .publication-body {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    min-inline-size: 0;
  }

  .publication-title {
    margin: 0;
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
  }

  .bibliography-authors,
  .bibliography-details {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .publication-award {
    color: var(--primary);
    font-weight: var(--font-weight-semibold);
  }

  .publication-abstract {
    margin: var(--space-3xs) 0 0;
    line-height: 1.65;
  }

  .publication-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    padding: 0;
    margin: 0;
    color: var(--primary);
    list-style: none;
    font-size: var(--step--1);
  }

  .publication-links :global(a) {
    display: inline-block;
    padding-block: var(--space-3xs);
  }

  .publication-media {
    aspect-ratio: 5 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .publication-media video,
  .publication-media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  @media (width >= 52rem) {
    .publication-card[data-has-image="true"] {
      grid-template-columns: minmax(10rem, 12rem) minmax(0, 1fr);
      align-items: start;
    }

    .publication-media {
      aspect-ratio: 5 / 4;
    }
  }
</style>
